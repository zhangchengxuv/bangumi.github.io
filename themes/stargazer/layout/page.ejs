<% if (page.path === 'index.html') { %>
  <article class="bangumi-page shell" data-detail-base="<%- url_for('/subject/') %>"><%- page.content %></article>
<% } else { %>
  <section class="page-hero shell compact">
    <p class="eyebrow"><span></span>ABOUT THE SCREENING ROOM</p>
    <h1><%= page.title %></h1>
    <% if (page.description) { %><p><%= page.description %></p><% } %>
  </section>
  <article class="prose shell"><%- page.content %></article>
<% } %>

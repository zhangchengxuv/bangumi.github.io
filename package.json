{
  "name": "hexo-bangumi-diary",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "description": "A polished Hexo anime tracking blog powered by Bangumi",
  "scripts": {
    "clean": "hexo clean",
    "build": "hexo clean && hexo generate",
    "dev": "hexo server",
    "sync:anime": "hexo bangumi -u",
    "sync:books": "hexo books -u",
    "sync:games": "hexo games -u",
    "sync:github": "node tools/sync-github-activity.js",
    "sync:bangumi": "hexo bangumi -u && hexo books -u && hexo games -u",
    "publish:preview": "hexo bangumi -u && hexo books -u && hexo games -u && hexo clean && hexo generate"
  },
  "engines": {
    "node": ">=20"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "githubActivity": {
    "username": "zhangchengxuv"
  },
  "dependencies": {
    "hexo": "8.1.2",
    "hexo-bilibili-bangumi": "2.1.9",
    "hexo-renderer-ejs": "2.0.0",
    "hexo-renderer-marked": "7.0.1",
    "hexo-server": "3.0.0",
    "pinyin-pro": "3.28.2"
  }
}
